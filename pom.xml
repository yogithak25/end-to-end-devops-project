<ns0:project xmlns:ns0="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0  http://maven.apache.org/xsd/maven-4.0.0.xsd">

 <ns0:modelVersion>4.0.0</ns0:modelVersion>

 <ns0:groupId>com.example</ns0:groupId>
 <ns0:artifactId>devops-demo-app</ns0:artifactId>
 <ns0:version>1.0</ns0:version>
 <ns0:packaging>jar</ns0:packaging>

 <ns0:name>DevOps Demo Application</ns0:name>
 <ns0:description>End-to-End DevOps CI/CD Pipeline Demo Project</ns0:description>

 <ns0:properties>
     <ns0:maven.compiler.source>17</ns0:maven.compiler.source>
     <ns0:maven.compiler.target>17</ns0:maven.compiler.target>
     <ns0:project.build.sourceEncoding>UTF-8</ns0:project.build.sourceEncoding>
 </ns0:properties>

 
 <ns0:dependencies>

     
     <ns0:dependency>
         <ns0:groupId>org.slf4j</ns0:groupId>
         <ns0:artifactId>slf4j-api</ns0:artifactId>
         <ns0:version>2.0.9</ns0:version>
     </ns0:dependency>

     <ns0:dependency>
         <ns0:groupId>org.slf4j</ns0:groupId>
         <ns0:artifactId>slf4j-simple</ns0:artifactId>
         <ns0:version>2.0.9</ns0:version>
     </ns0:dependency>

     
     <ns0:dependency>
         <ns0:groupId>junit</ns0:groupId>
         <ns0:artifactId>junit</ns0:artifactId>
         <ns0:version>4.13.2</ns0:version>
         <ns0:scope>test</ns0:scope>
     </ns0:dependency>

 </ns0:dependencies>

 
 <ns0:distributionManagement>

     <ns0:repository>
         <ns0:id>nexus</ns0:id>
         <ns0:url>http://98.130.129.172:8081/repository/maven-releases-custom/</ns0:url>
     </ns0:repository>

 </ns0:distributionManagement>

 <ns0:build>

     <ns0:plugins>

         
         <ns0:plugin>
             <ns0:groupId>org.apache.maven.plugins</ns0:groupId>
             <ns0:artifactId>maven-compiler-plugin</ns0:artifactId>
             <ns0:version>3.11.0</ns0:version>
             <ns0:configuration>
                 <ns0:source>17</ns0:source>
                 <ns0:target>17</ns0:target>
             </ns0:configuration>
         </ns0:plugin>
         <ns0:plugin>
    <ns0:groupId>org.apache.maven.plugins</ns0:groupId>
    <ns0:artifactId>maven-shade-plugin</ns0:artifactId>
    <ns0:version>3.5.0</ns0:version>

    <ns0:executions>
        <ns0:execution>
            <ns0:phase>package</ns0:phase>
            <ns0:goals>
                <ns0:goal>shade</ns0:goal>
            </ns0:goals>

            <ns0:configuration>
                <ns0:createDependencyReducedPom>false</ns0:createDependencyReducedPom>

                <ns0:transformers>
                    <ns0:transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                        <ns0:mainClass>com.example.DemoApp</ns0:mainClass>
                    </ns0:transformer>
                </ns0:transformers>

            </ns0:configuration>

        </ns0:execution>
    </ns0:executions>
</ns0:plugin>
         
         <ns0:plugin>
             <ns0:groupId>org.apache.maven.plugins</ns0:groupId>
             <ns0:artifactId>maven-surefire-plugin</ns0:artifactId>
             <ns0:version>3.2.5</ns0:version>
         </ns0:plugin>

         
         <ns0:plugin>
             <ns0:groupId>org.jacoco</ns0:groupId>
             <ns0:artifactId>jacoco-maven-plugin</ns0:artifactId>
             <ns0:version>0.8.11</ns0:version>

             <ns0:executions>

                 <ns0:execution>
                     <ns0:goals>
                         <ns0:goal>prepare-agent</ns0:goal>
                     </ns0:goals>
                 </ns0:execution>

                 <ns0:execution>
                     <ns0:id>report</ns0:id>
                     <ns0:phase>test</ns0:phase>
                     <ns0:goals>
                         <ns0:goal>report</ns0:goal>
                     </ns0:goals>
                 </ns0:execution>

             </ns0:executions>
         </ns0:plugin>

         
         <ns0:plugin>
             <ns0:groupId>org.apache.maven.plugins</ns0:groupId>
             <ns0:artifactId>maven-jar-plugin</ns0:artifactId>
             <ns0:version>3.3.0</ns0:version>

             <ns0:configuration>
                 <ns0:archive>
                     <ns0:manifest>
                         <ns0:mainClass>com.example.DemoApp</ns0:mainClass>
                     </ns0:manifest>
                 </ns0:archive>
             </ns0:configuration>
         </ns0:plugin>

     </ns0:plugins>

 </ns0:build>

</ns0:project>